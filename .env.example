# Device addresses and passwords. Copy to .env and fill in.
# Settings (thresholds, times, colors, tariff) are in config.toml.
# Give all devices a fixed IP (DHCP reservation) in your router.

# Huawei SDongle (read-only, Modbus TCP must be enabled)
SDONGLE_HOST=192.168.1.10
SDONGLE_PORT=502

# Shelly Gen2+/Gen3 plug - pool pump (leave HOST empty if you don't have one)
SHELLY_POOL_HOST=192.168.1.20
SHELLY_POOL_SCRIPT_ID=1
SHELLY_POOL_USER=admin
SHELLY_POOL_PASSWORD=
SHELLY_POOL_AP_PASSWORD=

# Shelly Gen2+/Gen3 plug - hot water boiler (leave HOST empty if you don't have one)
SHELLY_BOILER_HOST=192.168.1.21
SHELLY_BOILER_SCRIPT_ID=1
SHELLY_BOILER_USER=admin
SHELLY_BOILER_PASSWORD=
SHELLY_BOILER_AP_PASSWORD=

# Shelly Color Bulb (Gen1) - power indicator (leave HOST empty if you don't have one)
SHELLY_BULB_HOST=192.168.1.22
SHELLY_BULB_USER=admin
SHELLY_BULB_PASSWORD=

# FusionSolar cloud (read-only history download, fusionsolar.py; leave USER empty to skip)
FUSION_SOLAR_CLOUD=https://eu5.fusionsolar.huawei.com/unisso/login.action#/view/station/NE=12345678/overview
FUSION_SOLAR_SUBDOMAIN=uni005eu5
FUSION_SOLAR_USER=
FUSION_SOLAR_PASSWORD=
